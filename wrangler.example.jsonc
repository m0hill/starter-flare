{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "your-domain.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "your-kv-namespace-id",
      "preview_id": "your-kv-preview-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "your-bucket-name"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "your-cloudflare-database-id",
      "database_name": "your-database-name"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "routes": [
        {
          "pattern": "staging.your-domain.com",
          "custom_domain": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "your-staging-kv-namespace-id"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "your-staging-bucket-name"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "your-staging-cloudflare-database-id",
          "database_name": "your-staging-database-name"
        }
      ]
    }
  }
}
